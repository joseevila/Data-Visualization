{
  "cleanUrls": true,
  "functions": { "api/*.js": { "includeFiles": "data.json" } },
  "headers": [
    { "source": "/data.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
